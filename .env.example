# Data source for expert listings.
# Use "mock" for local UI work without Supabase data, or "supabase" for real data.
GOLGORU_DATA_SOURCE=mock

# Supabase project settings.
# Required for Google login, admin auth, and any Supabase-backed data source.
NEXT_PUBLIC_SUPABASE_URL=https://dmyxxnkqyzkvkxvpwild.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-service-role-secret-key

# Server-only Gemini key.
# Text input falls back locally if omitted. Voice input requires this key.
GEMINI_API_KEY=replace-with-gemini-api-key
