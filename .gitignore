# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local tooling / editor state (machine-specific)
.bkit/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tools
.antigravitycli/

# bkit auto-generated session state (changes every session)
docs/.bkit-memory.json
docs/.pdca-status.json
docs/.pdca-snapshots/

# 카카오 로그인 학습 샘플 (자체 git 저장소, 메인 프로젝트와 별개)
/dev-node/

# supabase CLI 임시 폴더
/supabase/.temp/

# superpowers SDD 실행 로그 (세션별 스크래치)
.superpowers/
